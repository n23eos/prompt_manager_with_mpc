{
  "name": "prompt-manager-app",
  "productName": "Prompt Manager",
  "version": "1.0.0",
  "description": "Prompt manager for macOS: menu bar, global hotkey palette, tags, variables, MCP server for AI agents",
  "main": "main.js",
  "bin": {
    "prompt-manager-mcp": "mcp-server/server.js"
  },
  "scripts": {
    "start": "electron .",
    "test": "node --test",
    "build:app": "electron-builder --mac",
    "mcp": "node mcp-server/server.js",
    "ingest": "node scripts/ingest/run.js"
  },
  "keywords": [
    "prompt",
    "prompt-manager",
    "mcp",
    "model-context-protocol",
    "claude",
    "ai",
    "electron",
    "macos"
  ],
  "author": "Nikolay",
  "license": "MIT",
  "devDependencies": {
    "electron": "^44.0.0",
    "electron-builder": "^26.15.3"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "zod": "^3.24.0"
  },
  "build": {
    "appId": "com.nikolay.promptmanager",
    "productName": "Prompt Manager",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "store.js",
      "renderer/**/*",
      "mcp-server/**/*",
      "seed/**/*",
      "assets/**/*"
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "identity": null
    }
  }
}
